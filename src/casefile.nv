// casefile.nv — the persisted failure file, which is the one optional
// host feature and is off by default.
//
// WHAT IT IS FOR.  A property that failed once should fail again on
// the next run without waiting for the generator to rediscover it.
// proptest writes a `.proptest-regressions` file; hypothesis keeps a
// `.hypothesis` database.  Both do it by default and both surprise
// people: a file appears in a repository nobody added, a build agent's
// cache decides which cases run, and a test that "passes on my
// machine" passes because of a file that is not in the checkout.
//
// SO IT IS OFF.  `PropConfig.case_file` is `None` in `defaults()`, and
// a program that wants the corpus names the path itself — which also
// means the path is in the program's own source, where a reader can
// see it, rather than invented by a library.
//
// THE FORMAT IS ONE CASE PER LINE, in `propcheck.replay_line`'s
// spelling — the same text a failure report prints and a person
// pastes back.  One format, three uses: the log line, the file, and
// the argument to `runner.replay`.  A line that does not parse is
// SKIPPED with the file otherwise intact, because a corpus is a cache
// and a corrupt cache should not stop a test run.
//
// THE ROW IS `[fs]` and nothing else.  No `[io]`: this writes a file,
// it does not print, and a library does not decide that something
// appears on a console.

use propcheck

// One recorded case.
//
// ```novo
// use casefile
//
// fn main() [io]
//     let c = SavedCase { seed: 42, choices: [3, 1, 4], why: "not an involution" }
//     println("${c.seed}")
// ```
pub struct SavedCase
    // The seed the run that found it started from.
    seed: Int
    // The minimal transcript, which is what `runner.replay` takes.
    choices: [Int]
    // What the property said was wrong, kept so a corpus reads as a
    // list of known bugs rather than a list of numbers.
    why: Str

// Why a case file could not be read or written.
//
// ```novo
// use casefile
//
// fn main() [io]
//     println(casefile.case_fault_path(CaseUnreadable("/x", "denied")))
// ```
pub enum CaseFileFault
    // The file exists and could not be read.  A file that is simply
    // ABSENT is not a fault — `load_cases` returns an empty list —
    // because a corpus that has not been started yet is the ordinary
    // state.
    CaseUnreadable(path: Str, why: Str)
    // The file could not be written.
    CaseWriteFailed(path: Str, why: Str)
    // The directory the file lives in could not be made.
    CaseDirFailed(path: Str, why: Str)

// The reason, as one line of text.
//
// The `Error` trait's method, which is what `Result<_, CaseFileFault>`
// requires.
impl Error for CaseFileFault
    // Answer the one line: which file, and what went wrong with it.
    //
    // The path comes first and the reason second, because the path is
    // what a reader acts on — it is the thing to go and look at — and
    // the reason is the library's guess at why.
    fn message(self) -> Str
        match self
            CaseUnreadable(path, why)  => "proptest-nv: cannot read the case file ${path}: ${why}"
            CaseWriteFailed(path, why) => "proptest-nv: cannot write the case file ${path}: ${why}"
            CaseDirFailed(path, why)   => "proptest-nv: cannot make the directory ${path}: ${why}"

// The path a fault is about.
//
// ```novo
// use casefile
//
// fn main() [io]
//     println(casefile.case_fault_path(CaseWriteFailed("/x", "full")))
// ```
pub fn case_fault_path(f: CaseFileFault) -> Str
    match f
        CaseUnreadable(path, _)  => path
        CaseWriteFailed(path, _) => path
        CaseDirFailed(path, _)   => path

// ── private helpers ──────────────────────────────────────────────────

// The separator between a case's replay line and its reason.
//
// A space, an em dash and a space — five bytes, and `SEPARATOR_BYTES`
// is that number written down, because the parse below needs the
// reason's byte offset and `str.index` answers bytes.  A reason of a
// caller's own may contain the separator itself; the parse splits at
// the FIRST one, so everything after it stays in the reason.
const SEPARATOR = " — "
const SEPARATOR_BYTES = 5

// A reason as one line.
//
// A saved case is one LINE of a file, so a reason with a newline in it
// would write a second line that does not parse and would be counted
// by `bad_lines` as damage this module caused.  Newlines become
// spaces; a carriage return is dropped rather than turned into a
// trailing space, because a reason is usually written with `\n` on a
// platform that also has `\r\n`.
fn one_line(why: Str) -> Str
    str.replace_all(str.replace_all(why, "\r", ""), "\n", " ")

// One saved case as the text the file holds.
//
// `propcheck.replay_line`'s spelling, plus the reason when there is
// one.  README rule 11: one format, three uses — this is the line the
// failure report prints, the line the file holds, and the text a
// person pastes back.
fn case_line(c: SavedCase) -> Str
    let head = propcheck.replay_line(c.seed, c.choices)
    let why = one_line(c.why)
    if why == ""
        return head
    "${head}${SEPARATOR}${why}"

// A saved case from one line of text, or `None` if the line is not a
// case.
//
// The reason is optional: a corpus a person edited by hand, or one
// written by a tool that had no reason to record, is still a corpus.
fn parse_case_line(line: Str) -> ?SavedCase
    let text = str.trim(line)
    if text == ""
        return None
    match str.index(text, SEPARATOR)
        None     => parse_replay(text, "")
        Some(at) => parse_replay(str.slice(text, 0, at),
                                 str.slice(text, at + SEPARATOR_BYTES, str.len(text)))

// A saved case from a replay line and the reason that followed it.
fn parse_replay(head: Str, why: Str) -> ?SavedCase
    match propcheck.parse_replay_line(head)
        Some(sc) => Some(SavedCase { seed: sc.0, choices: sc.1, why: why })
        None     => None

// Whether a line of a file is one `load_cases` reads.
//
// A blank line counts as readable: it is not a case, and a file with a
// trailing newline has one.  Counting it as damage would make every
// file this module writes report a bad line.
fn readable_line(line: Str) -> Bool
    if str.trim(line) == ""
        return true
    match parse_case_line(line)
        Some(_) => true
        None    => false

// Whether the corpus already holds this case.
//
// The transcript is the identity, not the seed and not the reason: two
// runs of the same property find the same choice sequence, and a case
// whose reason text was edited is the same bug.
fn holds_case(known: [SavedCase], c: SavedCase) -> Bool
    for k in known
        if k.choices == c.choices and k.seed == c.seed
            return true
    false

// The directory a path lives in, or `""` when it names a file in the
// working directory.
//
// Written by splitting rather than by searching backwards for a
// separator, because `str` has no reverse index: `str.index_from` only
// walks forwards.  The empty leading field an absolute path gives is
// kept and rejoined, which is what puts the leading slash back.
fn parent_of(path: Str) -> Str
    let parts = str.split(path, "/")
    if list.len(parts) <= 1
        return ""
    let cut = list.len(parts) - 1
    let head = str.join(parts[:cut], "/")
    if head == "" and str.starts_with(path, "/")
        return "/"
    head

// Append one case, making the directory and the file if they are not
// there.
//
// `fs.append` creates the file when it is absent, so the only thing
// that has to be made by hand is the directory — and `mkdir_all` is
// the one that makes the whole chain, which is what a path like
// `.proptest/regressions/reverse` needs.
fn append_case(path: Str, known: [SavedCase], c: SavedCase) -> Result<Int, CaseFileFault> [fs]
    let dir = parent_of(path)
    if dir != "" and not fs.is_dir(dir)
        if not fs.mkdir_all(dir)
            return Err(CaseDirFailed(dir, "the directory could not be made"))
    if not fs.append(path, case_line(c) + "\n")
        return Err(CaseWriteFailed(path, "the file is there and could not be appended to"))
    Ok(list.len(known) + 1)

// The cases a file holds, oldest first.
//
// An absent file is an empty list, not a fault.  A line that does not
// parse is skipped and counted by `bad_lines` rather than failing the
// read, because a corpus is a cache.
//
// ```novo
// use casefile
// use std.list
//
// fn known(path: Str) -> Int [fs]
//     match casefile.load_cases(path)
//         Ok(cs) => list.len(cs)
//         Err(_) => 0 - 1
// ```
pub fn load_cases(path: Str) -> Result<[SavedCase], CaseFileFault> [fs]
    if not fs.exists(path)
        return Ok([])
    match fs.read(path)
        Some(text) => Ok(parse_cases(text))
        None       => Err(CaseUnreadable(path, "the file is there and could not be read"))

// Append one case, creating the file and its directory if needed.
//
// Appends rather than replaces: a corpus is a list of bugs this
// property has had, and a run that found a second one should not lose
// the first.  A case whose transcript is already in the file is not
// written twice.
//
// Returns how many cases the file holds afterwards.
//
// ```novo
// use casefile
//
// fn remember(path: Str, c: SavedCase) -> Result<Int, CaseFileFault> [fs]
//     casefile.record(path, c)
// ```
pub fn record(path: Str, c: SavedCase) -> Result<Int, CaseFileFault> [fs]
    match load_cases(path)
        Err(f)    => Err(f)
        Ok(known) =>
            if holds_case(known, c)
                return Ok(list.len(known))
            append_case(path, known, c)

// How many lines of a file did not parse.
//
// So a program can say "your corpus has three lines I could not read"
// rather than silently running fewer cases than the file suggests.
//
// ```novo
// use casefile
//
// fn main() [fs, io]
//     println("${casefile.bad_lines(".proptest/reverse")}")
// ```
pub fn bad_lines(path: Str) -> Int [fs]
    if not fs.exists(path)
        return 0
    match fs.read(path)
        None    => 0
        Some(t) =>
            var n = 0
            for line in str.lines(t)
                if not readable_line(line)
                    n = n + 1
            n

// A file's cases as text, in the format `load_cases` reads.
//
// **Returns the text; it does not write it.**  For a program that
// wants the corpus in its own output — a failure summary, a comment on
// a pull request — without a second serialiser to keep in step.
//
// ```novo
// use casefile
//
// fn main() [io]
//     let c = SavedCase { seed: 42, choices: [3, 1], why: "too long" }
//     println(casefile.render_cases([c]))
// ```
pub fn render_cases(cs: [SavedCase]) -> Str
    if list.len(cs) == 0
        return ""
    str.join(list.map(cs, c => case_line(c)), "\n") + "\n"

// Cases back out of text.  **No effects.**
//
// The inverse of `render_cases`, and what `load_cases` is written on
// top of — so the grammar is testable against a fixture string with no
// file on disk.
//
// ```novo
// use casefile
// use std.list
//
// fn count(text: Str) -> Int
//     list.len(casefile.parse_cases(text))
// ```
pub fn parse_cases(text: Str) -> [SavedCase]
    var out: [SavedCase] = []
    for line in str.lines(text)
        if let Some(c) = parse_case_line(line)
            list.push(out, c)
    out
