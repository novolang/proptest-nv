// verdict.nv — what a run says when it is over.
//
// The CONFIGURATION lives in `runner`, beside the functions that read
// it; this module is the answer, not the question.
//
// THREE VERDICTS, NOT TWO.  A run that finished its cases passed; a
// run that found a counterexample failed; and a run that could not
// generate enough usable cases is EXHAUSTED, which is neither.  The
// third one is the diagnosis a person needs when a `filter` is too
// tight or an `assumed` is never true: "your generator does not
// produce the values your property is about" is a different problem
// from "your property is wrong", and a runner that reported it as a
// pass would hide it entirely.
//
// A VERDICT IS A VALUE.  Nothing here prints, and the rendering
// functions RETURN text.  `runner.check_test` is the one place a
// message reaches a person, and it goes through `std.test` so a
// property failure reads like every other test failure.
//
// EVERY VERDICT CARRIES THE SEED, pass included.  A run that passed
// today and fails tomorrow is worth re-running at yesterday's seed,
// and a seed nobody recorded is a seed nobody has.

// What a run concluded.
//
// ```novo
// use verdict
//
// fn describe(v: PropVerdict<Int>) -> Str
//     verdict.verdict_name(v)
// ```
pub enum PropVerdict<T>
    // Every case held.  `cases` is how many ran, `seed` is what they
    // ran from — recorded even on a pass, because a run worth
    // repeating is a run whose seed somebody kept.
    PropPassed(cases: Int, seed: Int)
    // A case broke the property, and this is the minimal one.
    PropFailed(failure: PropFailure<T>)
    // Too many cases were skipped or discarded to conclude anything.
    // `ran` is how many actually reached the property; `skipped` is
    // how many did not.
    PropExhausted(ran: Int, skipped: Int, seed: Int)

// ── the constructors, which have to be written here ──────────────────

// The three variants, built where they are declared.
//
// A `PropVerdict` is built in this module and nowhere else, and that is
// a compiler defect and not a design decision.  Outside the module
// declaring a generic enum, a variant written on a RETURN — a
// function's tail expression, or a match arm that is one — is not
// closed to its instantiation: the payload variant reaches codegen as
// an undefined `@novo_user_<building module>.<Variant>` and stops the
// build at the LLVM verifier, and a unit variant is refused earlier
// with `E2003: undefined name`.  `runner` builds all three exactly
// there, and the first sign of it was
// `use of undefined value '@novo_user_runner.PropExhausted'`.
//
// A constructor beside the enum closes from its own return type, which
// does work in the declaring module, and a call to it is an ordinary
// call from anywhere — so `runner` reaches the variants through these
// three.  They are deliberately NOT `pub`: a sibling module in this
// package calls them either way, so the workaround costs the published
// surface nothing.  Recorded as
// `a-generic-enum-variant-outside-its-declaring-module-is-undefined-on-a-return`;
// when that filing closes, these three and the calls to them are what
// to revert.
fn passed<T>(cases: Int, seed: Int) -> PropVerdict<T>
    PropPassed(cases, seed)

fn failed<T>(f: PropFailure<T>) -> PropVerdict<T>
    PropFailed(f)

fn exhausted<T>(ran: Int, skipped: Int, seed: Int) -> PropVerdict<T>
    PropExhausted(ran, skipped, seed)

// The name of a verdict: `"passed"`, `"failed"`, `"exhausted"`.
//
// ```novo
// use verdict
//
// fn describe(v: PropVerdict<Int>) -> Str
//     verdict.verdict_name(v)
// ```
pub fn verdict_name<T>(v: PropVerdict<T>) -> Str
    match v
        PropPassed(_, _)       => "passed"
        PropFailed(_)          => "failed"
        PropExhausted(_, _, _) => "exhausted"

// Whether a verdict is a pass.
//
// `PropExhausted` is **false**: a run that could not generate usable
// cases has not established anything, and a caller that treated it as
// a pass would be exactly the caller this verdict exists to warn.
//
// ```novo
// use verdict
//
// fn ok(v: PropVerdict<Int>) -> Bool
//     verdict.held(v)
// ```
pub fn held<T>(v: PropVerdict<T>) -> Bool
    match v
        PropPassed(_, _) => true
        _                => false

// The seed behind any verdict.
//
// ```novo
// use verdict
//
// fn which_seed(v: PropVerdict<Int>) -> Int
//     verdict.seed_of(v)
// ```
pub fn seed_of<T>(v: PropVerdict<T>) -> Int
    match v
        PropPassed(_, seed)       => seed
        PropFailed(f)             => f.seed
        PropExhausted(_, _, seed) => seed

// The failure inside a `PropFailed`, or `None`.
//
// ```novo
// use verdict
//
// fn why(v: PropVerdict<Int>) -> Str
//     match verdict.failure_of(v)
//         Some(f) => f.why
//         None    => "nothing broke"
// ```
pub fn failure_of<T>(v: PropVerdict<T>) -> ?PropFailure<T>
    match v
        PropFailed(f) => Some(f)
        _             => None

// ── the three lines a verdict renders ────────────────────────────────

// Why two of `render`'s three lines are written out in its own arms.
//
// The obvious shape is one private helper per verdict, and it does not
// build: a private generic function called from a public generic
// function is not specialised for the instantiation, so `render<[Int]>`
// calling `failed_line<T>(f: PropFailure<T>)` is refused with
// "expected PropFailure<T> but got PropFailure<[Int]>".  The arms are
// therefore written in `render` itself, and only the exhausted line —
// which mentions no type parameter — is a helper.  Recorded as
// `generic-forwarding-to-a-package-generic-skips-monomorphisation`.

// The line an exhausted run renders.
//
// Both counts are printed.  "exhausted" alone leaves the reader
// wondering whether the generator produced nothing or the property
// refused everything, and those two want different fixes: a `filter`
// that is too tight, or an `assumed` that is never true.
fn exhausted_line(ran: Int, skipped: Int, seed: Int) -> Str
    "exhausted: ${ran} cases ran and ${skipped} were skipped (seed ${seed})"

// A verdict as the message a person reads, without the value.
//
// **Returns the text; it does not print it.**  The value is left out
// because `T` is generic and has no universal spelling in this
// language — `runner.check_test` takes a renderer for that, and this
// is the half that needs none.  What it carries is the seed and the
// transcript, in `propcheck.replay_line`'s spelling, so that the line
// a build log shows is the line a person pastes back.
//
// ```novo
// use verdict
//
// fn report(v: PropVerdict<Int>) -> Str
//     verdict.render(v)
// ```
pub fn render<T>(v: PropVerdict<T>) -> Str
    match v
        // The seed is here even though nothing failed, and that is
        // README rule 3: a run that passed today and fails tomorrow is
        // worth re-running at yesterday's seed, and a seed nobody
        // recorded is a seed nobody has.  `cases` is what makes the
        // line worth keeping — a pass of 3 cases and a pass of 256 are
        // different amounts of evidence.
        PropPassed(cases, seed)           => "passed ${cases} cases (seed ${seed})"
        // `propcheck.replay_line` is embedded rather than reformatted,
        // because README rule 11 says the line a report prints, the
        // line a case file holds and the text a person pastes back are
        // ONE spelling.  A second spelling here would make the file and
        // the log disagree the first time either changed.
        PropFailed(f)                     => "${f.why} (${propcheck.replay_line(f.seed, f.choices)})"
        PropExhausted(ran, skipped, seed) => exhausted_line(ran, skipped, seed)
